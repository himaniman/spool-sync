# Telegram bot (BotFather token) and the chat to write to (send /start to the bot, then read getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: only this printer's prints (serial); empty = every printer on the account
PRINTER_SERIAL=

# Sync pass period, seconds
INTERVAL_SEC=300
# Add a "running low" line under a deduction below this many grams
LOW_GRAMS=100
# Repeat a "can't deduct, fix the spool" message this often, hours
REMIND_HOURS=3
# Warn this many days before the Bambu login (~90 days) expires
TOKEN_WARN_DAYS=7
# Alert when the cloud keeps failing this long, seconds
OUTAGE_ALERT_SEC=3600
TZ=Asia/Ho_Chi_Minh
